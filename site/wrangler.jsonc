// ch-ui.com on Cloudflare Workers. The dashboard project is a Worker
// connected to this repository with root directory /site; its build runs
// `bun run build` and then `npx wrangler deploy`, which reads this file,
// uploads dist/ as static assets and bundles worker/index.ts. Nothing here
// runs on a developer's machine.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "ch-ui",
  "compatibility_date": "2026-09-01",
  // The newsletter endpoint. Its secrets (RESEND_API_KEY, RESEND_SEGMENT_ID)
  // are set in the dashboard under the Worker's Variables and Secrets.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Every page is a static asset; only /api/* runs the Worker.
    "run_worker_first": ["/api/*"]
  },
  // Five sign-ups a minute per client address. namespace_id is any integer
  // unique within the account.
  "ratelimits": [
    {
      "name": "NEWSLETTER_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
