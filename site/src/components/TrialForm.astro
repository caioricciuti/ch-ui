---
// Self-serve 30-day trial. Posts to the license server's /trial from the
// browser; the license arrives by email. A page may carry several of these.
// The fields sit in one row and wrap when the container is narrow, or one
// under the other with layout="stack".
interface Props {
  layout?: "row" | "stack";
}
const { layout = "row" } = Astro.props;
---

<form class="chui-trial not-content" data-trial-form data-layout={layout} novalidate>
  <div class="fields">
    <input class="chui-input" type="text" name="name" maxlength="80" placeholder="Name (optional)" aria-label="Name (optional)" autocomplete="name" />
    <input class="chui-input" type="email" name="email" required maxlength="320" placeholder="you@company.com" aria-label="Email" autocomplete="email" />
    <button class="chui-btn" data-variant="solid" type="submit">Start free trial</button>
  </div>
  <p class="chui-status" role="status" hidden></p>
  <p class="consent">
    By requesting a trial you agree to the <a href="/terms/">Terms</a> and the
    <a href="/privacy/">Privacy Policy</a>.
  </p>
</form>

<style>
  .chui-trial {
    display: grid;
    gap: 0.5rem;
  }
  .fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .fields input {
    flex: 1 1 10rem;
  }
  .fields button {
    flex: 0 0 auto;
  }
  [data-layout="stack"] .fields {
    flex-direction: column;
  }
  [data-layout="stack"] .fields > * {
    flex: 0 0 auto;
    width: 100%;
  }
  .consent {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--chui-fg-4);
  }
  .consent a {
    color: var(--chui-fg-3);
    text-underline-offset: 2px;
  }
</style>

<script>
  import { LICENSE_SERVER_URL, SUPPORT_EMAIL } from "../lib/license-server";
  import { track } from "../lib/analytics";
  import { showDone } from "../lib/forms";

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const GENERIC = `Something went wrong. Please try again, or email ${SUPPORT_EMAIL}.`;
  const IDLE = "Start free trial";

  interface TrialResponse {
    success?: boolean;
    message?: string;
    error?: string;
  }

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-trial-form]")) {
    const button = form.querySelector("button");
    const status = form.querySelector<HTMLElement>(".chui-status");
    if (!button || !status) continue;

    const say = (tone: "ok" | "error", text: string) => {
      status.dataset.tone = tone;
      status.textContent = text;
      status.hidden = false;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const email = String(data.get("email") ?? "").trim();
      const name = String(data.get("name") ?? "").trim();

      if (!EMAIL_RE.test(email)) {
        say("error", "Please enter a valid email address.");
        track("trial_failed", { reason: "invalid_email" });
        return;
      }

      button.disabled = true;
      button.textContent = "Sending…";
      status.hidden = true;
      track("trial_submitted", { has_name: name.length > 0 });

      try {
        const res = await fetch(`${LICENSE_SERVER_URL}/trial`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(name ? { email, name } : { email }),
        });
        let body: TrialResponse = {};
        try {
          body = (await res.json()) as TrialResponse;
        } catch {
          // Non-JSON body (a bare 429, say): the status decides below.
        }
        if (res.ok && body.success) {
          track("trial_started");
          showDone(
            form,
            "Check your inbox.",
            "The email arrives within a minute; look in the spam folder too. If this address already had a license, that is what you get, not a second trial. Upload the file in Settings → License.",
          );
          return;
        }
        const limited = res.status === 429;
        say(
          "error",
          body.error ?? (limited ? "Too many requests. Please wait a bit and try again." : GENERIC),
        );
        track("trial_failed", { reason: limited ? "rate_limited" : "server_error", status: res.status });
      } catch {
        say("error", GENERIC);
        track("trial_failed", { reason: "network_error" });
      }
      button.disabled = false;
      button.textContent = IDLE;
    });
  }
</script>
